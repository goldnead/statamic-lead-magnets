<?xml version="1.0" encoding="UTF-8"?>
<!--
    The same suite, against a real MySQL server.

        vendor/bin/pest -c phpunit.mysql.xml

    (`-c`, not the long form: two consecutive hyphens are illegal inside an XML
    comment and PHPUnit refuses to parse the file at all.)

    Needed because the default SQLite run cannot see the class of defect that
    took statamic-notifications' migrations down: InnoDB's 3072-byte index
    limit, utf8mb4's four bytes per character and fixed column widths do not
    exist in SQLite. This addon carries a three-column brand-scoped unique that
    ends in an email address, so the same blind spot applies here.

    tests/Unit/IndexKeyLengthTest.php measures the keys without a server and
    runs everywhere. This file is the second opinion: point
    DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD at a throwaway database
    and the suite migrates it from scratch on every test.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.mysql.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="testing"/>
        <env name="DB_DRIVER" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="lead_magnets_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="BRAND_CONTEXT_MULTI_BRAND" value="false"/>
    </php>
</phpunit>
